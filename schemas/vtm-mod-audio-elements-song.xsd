 <xs:annotation>
  <xs:documentation xml:lang='en-US'>
    Songs: Description information for song elements
  </xs:documentation>
 </xs:annotation>

 <!-- <xs:include schemaLocation='vtm-mod-generic-crew-types.xsd'/> -->
 <xs:include schemaLocation='vtm-mod-audio-catalog.xsd'/>
 <xs:include schemaLocation='vtm-mod-audio-classification.xsd'/>
 <xs:include schemaLocation='vtm-mod-audio-technical.xsd'/>


 <xs:complexType name='AudioContentSongTitleType'>   <!-- song -->
  <xs:annotation>
   <xs:documentation xml:lang='en-US'>
    The title of a song.

    Supports structured elements to handle things
    like mixes or variants.

   </xs:documentation>
  </xs:annotation>
  <xs:sequence>
   <xs:element name='main' type='xs:token' minOccurs='1' maxOccurs='1'/>
   <!-- future variant element (later) -->
  </xs:sequence>
 </xs:complexType>


 <xs:complexType name='AudioSongType'>  <!-- song -->
  <xs:annotation>
   <xs:documentation xml:lang='en-US'>
    Primary element for the song type.
   </xs:documentation>
  </xs:annotation>
  <xs:sequence>
   <xs:element name='title' type='AudioContentSongTitleType' minOccurs='1' maxOccurs='1'/>
   <xs:element name='catalog' type='AudioSongCatalogType' minOccurs='0' maxOccurs='1'/>
   <xs:element name='classification' type='AudioSongClassificationType' minOccurs='0' maxOccurs='1'/>
   <xs:element name='technical' type='AudioSongTechnicalType' minOccurs='1' maxOccurs='1'/>
   <xs:element name='composition' type='AudioSongCompositionType' minOccurs='0' maxOccurs='1'/>
   <xs:element name='performance' type='AudioSongPerformanceType' minOccurs='0' maxOccurs='1'/>
  </xs:sequence>
  <xs:attributeGroup ref='ElementAttributeGroup'/>
 </xs:complexType>


 <xs:complexType name='AudioSongCompositionType'>
  <xs:annotation>
   <xs:documentation xml:lang='en-US'>
    Contains elements that describe the comnposition of the song,
    which could include lyrics, narrative, reference
    information to other works.
   </xs:documentation>
  </xs:annotation>
 </xs:complexType>


 <xs:complexType name='AudioSongPerformanceType'>
  <xs:annotation>
   <xs:documentation xml:lang='en-US'>
    Contains elements that could describe the
    recorded performance of the song, including
    vocalists or musicians.
   </xs:documentation>
  </xs:annotation>
 </xs:complexType>

</xs:schema>

